<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>Your GearUp password was changed</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f7fb;color:#172033;font-family:Arial,Helvetica,sans-serif;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;">
      Your GearUp password has been changed successfully.
    </div>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f4f7fb;">
      <tr>
        <td align="center" style="padding:40px 16px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:600px;background:#ffffff;border:1px solid #e5eaf2;border-radius:16px;overflow:hidden;">
            <tr>
              <td style="padding:28px 36px;background:#173b67;">
                <div style="color:#ffffff;font-size:24px;font-weight:700;letter-spacing:.3px;">GearUp</div>
                <div style="margin-top:7px;color:#cfe0f4;font-size:13px;">Gear rental made simple</div>
              </td>
            </tr>
            <tr>
              <td style="padding:40px 36px 36px;">
                <div style="width:52px;height:52px;line-height:52px;text-align:center;color:#ffffff;background:#1f9d68;border-radius:50%;font-size:28px;">✓</div>
                <p style="margin:26px 0 12px;color:#172033;font-size:16px;">Hello <%= name %>,</p>
                <h1 style="margin:0 0 16px;color:#173b67;font-size:28px;line-height:1.25;">Password changed successfully</h1>
                <p style="margin:0;color:#526174;font-size:15px;line-height:1.7;">
                  Your GearUp password has been updated. You can now sign in with your new password.
                </p>
                <div style="margin:28px 0 0;padding:18px 20px;background:#f0faf5;border:1px solid #ccebdc;border-radius:10px;color:#246947;font-size:14px;line-height:1.7;">
                  If you did not make this change, contact GearUp support immediately and secure your email account.
                </div>
                <p style="margin:28px 0 0;color:#172033;font-size:15px;line-height:1.6;">The GearUp team</p>
              </td>
            </tr>
            <tr>
              <td style="padding:20px 36px;background:#f8fafc;border-top:1px solid #edf1f6;color:#7a8798;font-size:12px;line-height:1.6;">
                This is an automated message. Please do not reply to this email.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>